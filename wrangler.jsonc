{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "integritest",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "integritest",
      "database_id": "45aed9fa-2549-48a1-b78e-9a87709ccf82",
      "migrations_dir": "server/migrations"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}
